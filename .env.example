# ============================================================================
# Profile Matching — Environment Configuration
# Copy this file to `.env` and adjust values. All variables are optional;
# sensible production defaults are applied when unset.
# ============================================================================

# ---- Embeddings --------------------------------------------------------------
# Provider: huggingface | openai | cohere | hashing (offline fallback)
PM_EMBEDDING__PROVIDER=huggingface
PM_EMBEDDING__MODEL=sentence-transformers/all-MiniLM-L6-v2
PM_EMBEDDING__BATCH_SIZE=32
# API keys (only needed for managed providers)
PM_EMBEDDING__OPENAI_API_KEY=
PM_EMBEDDING__COHERE_API_KEY=

# ---- Vector store ------------------------------------------------------------
# Backend: chroma | memory
PM_VECTORSTORE__BACKEND=chroma
PM_VECTORSTORE__PERSIST_DIRECTORY=.vectorstore
PM_VECTORSTORE__COLLECTION_NAME=resumes

# ---- Chunking ----------------------------------------------------------------
PM_CHUNKING__MAX_CHUNK_CHARS=1200
PM_CHUNKING__CHUNK_OVERLAP_CHARS=150

# ---- Retrieval / matching ----------------------------------------------------
PM_MATCHING__TOP_K=10
PM_MATCHING__SEMANTIC_WEIGHT=0.7
PM_MATCHING__KEYWORD_WEIGHT=0.3

# ---- Paths -------------------------------------------------------------------
PM_PATHS__RESUME_DIR=data/resumes
PM_PATHS__JOB_DIR=data/job_descriptions

# ---- Logging -----------------------------------------------------------------
# Level: DEBUG | INFO | WARNING | ERROR
PM_LOG_LEVEL=INFO
